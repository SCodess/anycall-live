VITE_SIGNALING_SERVER=https://anycall-live-production.up.railway.app

# Production TURN (required for calls across symmetric NAT / mobile networks).
# Vite bakes these into the bundle at build time; redeploy after changing them.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
